# Variable names and placeholders only. Never put real values in this file.
# For local runs, export these in your terminal session instead of writing a .env file.

# Required
DATABRICKS_HOST=your-workspace.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id

# Optional. One of:
#   oauth-u2m (default) -- opens a browser OAuth prompt using your own
#     Databricks identity. No secret needed, local dev only.
#   oauth-m2m -- the production path; requires the two CLIENT_* vars below,
#     sourced from Key Vault, not from this file.
#   pat -- personal access token, local and temporary only. Refuses to start
#     if APP_ENV=production or WEBSITE_SITE_NAME is set. Requires
#     DATABRICKS_TOKEN below. See docs/local-connection.md before using this;
#     prefer oauth-u2m if it already works for you.
DATABRICKS_AUTH_MODE=oauth-u2m
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_TOKEN=

# Optional. Defaults to 500 if unset.
DEFAULT_ROW_CAP=500

# Optional. Local dev only; ignored when running behind App Service auth.
LOCAL_DEV_USER=
